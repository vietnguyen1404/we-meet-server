# App
NODE_ENV=development
PORT=3000

# Auth
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wemeet
CORS_ORIGIN=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# TURN / STUN (WebRTC NAT traversal)
# Comma-separated STUN URLs — defaults to Google's public STUN if unset
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN URLs (e.g. turn:host:3478,turns:host:5349). Leave blank to disable TURN.
TURN_URLS=
# Dynamic credential mode (recommended): HMAC-SHA1 short-lived credentials — min 16 chars
TURN_SECRET=
# Static credential mode (fallback): used only when TURN_SECRET is not set
TURN_USERNAME=
TURN_PASSWORD=
# Credential TTL in seconds for dynamic mode (default: 3600)
TURN_CREDENTIAL_TTL_SECONDS=3600
