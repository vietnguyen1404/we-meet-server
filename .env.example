# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wemeet?schema=public

# JWT Authentication
JWT_SECRET=your-super-secret-jwt
JWT_EXPIRES_IN=15m

# JWT Refresh Token
JWT_REFRESH_SECRET=your-super-secret-refresh-key-different-from-jwt-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
